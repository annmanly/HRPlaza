.marquee {
    width: 1024px;
    height: 768px;
    -unity-font-style: bold; 
    align-content: center;
    -unity-font-definition: var(--font-bold);
    color: black;
    background-color:white;
}

.countdown-label {
    font-size: 110px;
    position: absolute;
    align-self: center;
    top: 110px;
}

.countdown-timer {
    font-size: 100px;
    position: absolute;
    top: 220px;
    align-self: center;
}

.image-display {
    position: absolute;
    top: 375px;
    align-self: center;
    height: 268px;
    width: 800px;
    scale:1.25;
}

.hidden {
  display: none;
}

